pipeline{
    agent{
        node{
            label 'ROBOSHOP'
        }
    }
    environment{
        COURSE ="Jenkins"
    }
    stages {
        stage('Build') {
            steps {
                script {
                    sh """
                        echo "Building"
                        echo "course is: ${COURSE}"
                    """
                }

            }
        }
        stage('Test'){
            steps { 
                script{
                    sh """
                        echo "Testing"
                    """
                }
            }
        }
        stage ('Deploy'){
            steps {
                script {
                    sh """
                        echo "Deploying"
                    """
                }
            }
        }
    }

    post {
        always {
            echo "I will always say Hello again!"
        }

        success {
            echo "I will always say success if build paas"
        }

        failure {
            echo "I will always say error if build fail"
        }
    
    
    }
}